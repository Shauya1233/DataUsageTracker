<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#2a2a2a">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackground"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Camera"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:paddingStart="16dp" />

        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_more"
            android:contentDescription="More"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackground"
            android:tint="@android:color/white" />

    </LinearLayout>

    <!-- Camera preview -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topBar"
        android:layout_above="@+id/controlsBar" />

    <!-- Status text overlay -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="⏹ Ready to record"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:background="#80000000"
        android:padding="16dp" />

    <!-- Control buttons bar -->
    <LinearLayout
        android:id="@+id/controlsBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#2a2a2a"
        android:spacing="16dp">

        <!-- Speed/Effects button -->
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="Speed"
            android:scaleType="centerInside"
            android:background="@drawable/button_background"
            android:tint="@android:color/white"
            android:layout_margin="8dp" />

        <!-- Focus/Settings button -->
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="Focus"
            android:scaleType="centerInside"
            android:background="@drawable/button_background"
            android:tint="@android:color/white"
            android:layout_margin="8dp" />

        <!-- Record button (main) -->
        <ImageButton
            android:id="@+id/recordButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Record"
            android:scaleType="centerInside"
            android:background="@drawable/record_button_background"
            android:tint="@android:color/white"
            android:layout_margin="8dp" />

        <!-- Delete button -->
        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Delete"
            android:scaleType="centerInside"
            android:background="@drawable/button_background"
            android:tint="@android:color/white"
            android:layout_margin="8dp" />

        <!-- Gallery button -->
        <ImageButton
            android:id="@+id/galleryButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Gallery"
            android:scaleType="centerInside"
            android:background="@drawable/button_background"
            android:tint="@android:color/white"
            android:layout_margin="8dp" />

        <!-- Save button -->
        <ImageButton
            android:id="@+id/saveButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_save"
            android:contentDescription="Save"
            android:scaleType="centerInside"
            android:background="@drawable/button_background"
            android:tint="@android:color/white"
            android:layout_margin="8dp" />

    </LinearLayout>

</RelativeLayout>
